{
  "name": "xg-aigc-toolbox",
  "version": "0.49.4",
  "private": true,
  "type": "module",
  "description": "XG AIGC 工具箱：更衣室（人物三视图提示词 + 局部参考图），全部开源",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "names:dump": "node tools/dump-names.mjs names > names.json",
    "i18n:tw": "node tools/gen-zhtw.cjs names.json"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "opencc-js": "^1.0.5",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
